---
import Base from '../../layouts/Base.astro'
import Sidebar from '../../components/Sidebar.astro'
import { components, groups } from '../../data/components'
---

<Base title="Components" description="Framework-agnostic web components for the Hack Club design system.">
  <div class="hc-container docs-shell">
    <Sidebar />
    <article class="docs-content">
      <header class="page-header">
        <span class="hc-kicker">Components</span>
        <h1 class="hc-title">Web components</h1>
        <p class="hc-lead">
          Custom elements built with Lit. They work in plain HTML and in React, Vue, Svelte,
          Astro, or anything else that renders HTML. Each one reads the <code>--hc-</code> tokens,
          so it follows light and dark mode automatically.
        </p>
      </header>
      {
        groups.map(group => (
          <section>
            <h2>{group}</h2>
            <div class="grid">
              {components
                .filter(c => c.group === group)
                .map(c => (
                  <hc-card href={`/components/${c.slug}/`} variant="outline">
                    <h3 class="card-title">{c.name}</h3>
                    <p class="card-text">{c.tags.map(t => `<${t}>`).join(' ')}</p>
                  </hc-card>
                ))}
            </div>
          </section>
        ))
      }
    </article>
  </div>
</Base>
