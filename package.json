{
  "private": true,
  "scripts": {
    "build": "lerna run build",
    "prepare": "yarn build",
    "clean": "lerna run clean",
    "test": "jest",
    "test:e2e": "yarn clean && yarn build && yarn test && node scripts/dist-smoke.cjs && yarn --cwd docs build",
    "format": "prettier --write .",
    "checkFormat": "prettier --check ."
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "devDependencies": {
    "@swc/core": "^1.15.18",
    "@swc/jest": "^0.2.39",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "lerna": "^9.0.5",
    "microbundle": "^0.15.1",
    "prettier": "^3.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.[jt]sx?$": [
        "@swc/jest",
        {
          "jsc": {
            "parser": {
              "syntax": "ecmascript",
              "jsx": true
            },
            "transform": {
              "react": {
                "runtime": "automatic"
              }
            }
          }
        }
      ]
    },
    "testMatch": [
      "**/packages/**/test/*.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ]
  },
  "dependencies": {}
}
