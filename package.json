{
  "name": "hackclub-theme",
  "description": "Hack Club's design system monorepo",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hackclub/theme.git"
  },
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4"
  },
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "scripts": {
    "build": "lerna run build",
    "clean": "lerna run clean",
    "test": "bun test",
    "test:dist": "node scripts/dist-smoke.mjs",
    "test:e2e": "bun run clean && bun run build && bun run test && bun run test:dist && bun run docs:build",
    "docs:dev": "bun run --cwd docs dev",
    "docs:build": "bun run --cwd docs build",
    "format": "prettier --write .",
    "checkFormat": "prettier --check .",
    "prepare": "bun run build"
  },
  "devDependencies": {
    "@hackclub/components": "workspace:*",
    "@hackclub/css-base": "workspace:*",
    "@hackclub/meta": "workspace:*",
    "@hackclub/theme": "workspace:*",
    "@hackclub/tokens": "workspace:*",
    "@happy-dom/global-registrator": "^21.0.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.3",
    "lerna": "^10.1.1",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2"
  }
}
