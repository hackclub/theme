{
  "name": "@hackclub/tokens",
  "description": "Hack Club's design tokens as JS, JSON, CSS custom properties and a Tailwind CSS theme",
  "version": "1.0.0",
  "keywords": [
    "hack club",
    "design tokens",
    "css variables",
    "tailwind"
  ],
  "homepage": "https://design.hackclub.com",
  "bugs": "https://github.com/hackclub/theme/issues",
  "license": "MIT",
  "author": "Hack Club <team@hackclub.com> (https://hackclub.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hackclub/theme.git",
    "directory": "packages/tokens"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist/"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./tokens.json": "./dist/tokens.json"
  },
  "scripts": {
    "build": "bun run build.ts",
    "watch": "bun run --watch build.ts",
    "clean": "rm -rf ./dist",
    "prepublishOnly": "bun run build"
  },
  "publishConfig": {
    "access": "public"
  }
}
