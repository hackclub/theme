{
  "name": "@hackclub/theme",
  "description": "Hack Club’s theme for Theme UI websites",
  "version": "1.0.0",
  "author": "Lachlan Campbell <lachlan@hackclub.com> (https://lachlanjc.com)",
  "main": "dist/index.js",
  "module": "dist/index.esm.mjs",
  "unpkg": "dist/index.esm.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.esm.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "fonts/"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "bun run build.ts",
    "prepare": "bun run build",
    "watch": "bun run --watch build.ts",
    "clean": "rm -rf ./dist"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hackclub/theme.git",
    "directory": "packages/theme"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "theme-ui": "^0.17.4"
  }
}
