{
  "name": "@hackclub/theme",
  "description": "Hack Club’s design system: tokens, CSS and framework-agnostic web components",
  "version": "2.0.0",
  "author": "Hack Club <team@hackclub.com> (https://hackclub.com)",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/hackclub.js",
  "jsdelivr": "dist/hackclub.js",
  "style": "dist/hackclub.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cdn": "./dist/hackclub.js",
    "./css": "./dist/hackclub.css",
    "./hackclub.css": "./dist/hackclub.css",
    "./base.css": "./dist/base.css",
    "./fonts.css": "./dist/fonts.css",
    "./prose.css": "./dist/prose.css",
    "./tokens.css": "./dist/tokens.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./tokens.json": "./dist/tokens.json",
    "./fonts/*": "./dist/fonts/*",
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    }
  },
  "files": [
    "dist/"
  ],
  "sideEffects": true,
  "keywords": [
    "hack club",
    "design system",
    "web components",
    "design tokens",
    "css"
  ],
  "scripts": {
    "build": "bun run build.ts",
    "prepublishOnly": "bun run build",
    "watch": "bun run --watch build.ts",
    "clean": "rm -rf ./dist"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hackclub/theme.git",
    "directory": "packages/theme"
  },
  "dependencies": {
    "@hackclub/components": "workspace:*",
    "@hackclub/tokens": "workspace:*"
  },
  "devDependencies": {
    "@hackclub/css-base": "workspace:*"
  }
}
