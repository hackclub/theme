{
  "name": "@bio-x/theme",
  "description": "BioX theme for Theme UI websites",
  "version": "1.0.0",
  "author": "Dr Data",
  "source": "src/index.ts",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "unpkg": "dist/index.umd.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./retro": {
      "types": "./dist/retro.d.ts",
      "import": "./dist/retro.esm.js",
      "require": "./dist/retro.js",
      "default": "./dist/retro.js"
    },
    "./fonts/reg.css": "./fonts/reg.css",
    "./fonts/reg-bold.css": "./fonts/reg-bold.css",
    "./fonts/reg-ital-bold.css": "./fonts/reg-ital-bold.css",
    "./fonts/noto-sans-chinese.css": "./fonts/noto-sans-chinese.css"
  },
  "sideEffects": false,
  "scripts": {
    "prepare": "microbundle src/index.ts src/retro.ts",
    "watch": "microbundle watch --no-compress src/index.ts src/retro.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dr-data/biox-theme.git",
    "directory": "packages/theme"
  },
  "gitHead": "029e83b336da014076112a68048dfa65565013ee",
  "dependencies": {
    "theme-ui": "^0.14.5"
  }
}