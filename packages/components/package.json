{
  "name": "@hackclub/components",
  "description": "Framework-agnostic web components for Hack Club's design system",
  "version": "1.0.0",
  "keywords": [
    "hack club",
    "web components",
    "custom elements",
    "lit",
    "design system"
  ],
  "homepage": "https://theme.hackclub.com",
  "bugs": "https://github.com/hackclub/theme/issues",
  "license": "MIT",
  "author": "Hack Club <team@hackclub.com> (https://hackclub.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hackclub/theme.git",
    "directory": "packages/components"
  },
  "type": "module",
  "sideEffects": [
    "./dist/index.js",
    "./dist/icons.js",
    "./dist/components/*.js"
  ],
  "files": [
    "dist/"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "default": "./dist/theme.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "default": "./dist/icons.js"
    },
    "./*": {
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    }
  },
  "scripts": {
    "build": "bun run build.ts",
    "watch": "bun run --watch build.ts",
    "clean": "rm -rf ./dist",
    "icons": "bun run scripts/gen-icons.tsx",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@hackclub/tokens": "workspace:*",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@hackclub/css-base": "workspace:*",
    "@hackclub/icons": "^0.2.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
