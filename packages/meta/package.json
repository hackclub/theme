{
  "name": "@hackclub/meta",
  "description": "Generate meta tags for Hack Club pages",
  "version": "1.2.0",
  "source": "src/index.js",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "unpkg": "dist/index.umd.js",
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf ./dist && microbundle --jsxImportSource react --jsx jsx --globals react/jsx-runtime=jsxRuntime",
    "prepare": "yarn build",
    "watch": "microbundle watch --jsxImportSource react --jsx jsx --globals react/jsx-runtime=jsxRuntime --no-compress",
    "clean": "rm -rf ./dist"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hackclub/theme.git",
    "directory": "packages/meta"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "gitHead": "029e83b336da014076112a68048dfa65565013ee"
}
